<!DOCTYPE html>
<html lang="zh-TW">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Chill Meme 產生器</title>

<!-- Google Fonts: 休閒輕鬆風 -->
<link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;800&family=Nunito:wght@400;700&display=swap" rel="stylesheet">

<!-- html2canvas CDN：用來截圖下載 -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

<style>
:root{
  --bg:#FFF8E7;
  --card:#FFFFFF;
  --primary:#FF7A45;
  --primary-dark:#E86532;
  --text:#3D2E2E;
  --border:#FFE4B5;
}
*{box-sizing:border-box; margin:0; padding:0;}
body{
  font-family: 'Nunito', sans-serif;
  background: var(--bg);
  color: var(--text);
  min-height:100vh;
  background-image: radial-gradient(#FFDAB9 2px, transparent 2px);
  background-size: 22px 22px;
}

header{
  text-align:center;
  padding:28px 16px 10px;
}
header h1{
  font-family: 'Baloo 2', cursive;
  font-size: clamp(28px, 5vw, 42px);
  font-weight:800;
  letter-spacing:1px;
}
header p{opacity:.7; margin-top:4px;}

.container{
  max-width:1100px;
  margin:0 auto;
  padding:16px;
  display:grid;
  grid-template-columns: 360px 1fr;
  gap:20px;
  align-items:start;
}

/* 左邊控制面板 */
.panel{
  background:var(--card);
  border:3px solid var(--border);
  border-radius:20px;
  padding:20px;
  box-shadow: 6px 6px 0px var(--border);
  position:sticky;
  top:16px;
}
.panel h2{
  font-family: 'Baloo 2', cursive;
  font-size:22px;
  margin-bottom:16px;
}
.control-group{ margin-bottom:20px; }
.control-group label{
  display:block;
  font-weight:700;
  font-size:14px;
  margin-bottom:8px;
}
.hint{ font-size:12px; opacity:.6; margin-top:6px; }

/* 輸入框美化 */
input[type="text"], input[type="file"]{
  width:100%;
  padding:10px 12px;
  border-radius:12px;
  border:2px solid var(--border);
  font-family: 'Nunito', sans-serif;
  font-size:14px;
  outline:none;
}
input[type="text"]:focus{ border-color: var(--primary); }

input[type="range"]{
  width:100%;
  accent-color: var(--primary);
}

/* 按鈕 */
.btn{
  width:100%;
  padding:14px;
  border:none;
  border-radius:14px;
  font-family: 'Baloo 2', cursive;
  font-size:18px;
  font-weight:800;
  cursor:pointer;
  transition:.15s;
}
.btn-primary{
  background:var(--primary);
  color:white;
  box-shadow: 0 4px 0 var(--primary-dark);
}
.btn-primary:active{
  transform:translateY(3px);
  box-shadow: 0 1px 0 var(--primary-dark);
}
.btn:disabled{ opacity:.5; cursor:not-allowed; }

/* 右邊預覽區 */
.preview-wrap{
  background:var(--card);
  border:3px solid var(--border);
  border-radius:20px;
  padding:16px;
  box-shadow: 6px 6px 0px var(--border);
}
.preview-title{
  font-family: 'Baloo 2', cursive;
  text-align:center;
  margin-bottom:12px;
}

/* 這個區塊會被 html2canvas 截圖 */
#meme-canvas{
  position:relative;
  width:100%;
  aspect-ratio: 1 / 1; /* 正方形迷因最好看 */
  max-width:600px;
  margin:0 auto;
  background:#E9E9E9;
  border-radius:16px;
  overflow:hidden;
  display:flex;
  align-items:center;
  justify-content:center;
}
#meme-canvas img{
  width:100%;
  height:100%;
  object-fit:cover; /* 圖片自動填滿 */
  display:none;
}
#meme-canvas .placeholder{
  text-align:center;
  opacity:.5;
  padding:20px;
}

/* 迷因文字樣式：白字 + 黑粗邊框 */
.meme-text{
  position:absolute;
  left:50%;
  transform:translateX(-50%);
  width:92%;
  text-align:center;
  font-family: 'Baloo 2', cursive;
  font-weight:800;
  color:white;
  text-transform:uppercase;
  word-break:break-word;
  line-height:1.1;
  /* 關鍵：黑色粗邊框，讓任何底圖都清楚 */
  text-shadow:
    -3px -3px 0 #000,
     3px -3px 0 #000,
    -3px  3px 0 #000,
     3px  3px 0 #000,
     0px  4px 0 #000;
  pointer-events:none;
}
#top-text{ top:5%; }
#bottom-text{ bottom:5%; }

/* 手機 RWD */
@media(max-width: 800px){
  .container{
    grid-template-columns: 1fr;
  }
  .panel{ position:static; }
  #meme-canvas{ aspect-ratio: 4 / 3; }
}
</style>
</head>
<body>

<header>
  <h1>😎 Chill Meme 工廠</h1>
  <p>上傳照片 → 輸入幹話 → 一鍵下載</p>
</header>

<div class="container">
  <!-- 左邊：控制面板 -->
  <div class="panel">
    <h2>控制台</h2>

    <div class="control-group">
      <label>1. 上傳你的底圖</label>
      <!-- 避開CORS：用 file input + FileReader 讀本機圖片 -->
      <input type="file" id="image-input" accept="image/*">
      <div class="hint">支援 JPG / PNG，完全在你電腦上處理，不會上傳</div>
    </div>

    <div class="control-group">
      <label>2. 上方文字</label>
      <input type="text" id="input-top" placeholder="EX: 當教授說..." value="當教授說">
    </div>

    <div class="control-group">
      <label>3. 下方文字</label>
      <input type="text" id="input-bottom" placeholder="EX: 這題不會考" value="這題不會考">
    </div>

    <hr style="border:none; border-top:2px dashed var(--border); margin:16px 0;">

    <div class="control-group">
      <label>字體大小：<span id="size-value">48px</span></label>
      <!-- 滑桿控制字體大小 -->
      <input type="range" id="size-slider" min="20" max="100" value="48">
    </div>

    <div class="control-group">
      <label>上方文字高度：<span id="top-pos-value">5%</span></label>
      <input type="range" id="top-pos-slider" min="0" max="50" value="5">
    </div>

    <div class="control-group">
      <label>下方文字高度：<span id="bottom-pos-value">5%</span></label>
      <input type="range" id="bottom-pos-slider" min="0" max="50" value="5">
    </div>

    <!-- 下載按鈕 -->
    <button class="btn btn-primary" id="download-btn" disabled>⬇️ 下載 my-meme.png</button>
  </div>

  <!-- 右邊：即時預覽 -->
  <div class="preview-wrap">
    <div class="preview-title">即時預覽</div>
    <div id="meme-canvas">
      <div class="placeholder">👈 先從左邊上傳一張圖片吧！</div>
      <img id="meme-image" src="" alt="meme base">
      <div id="top-text" class="meme-text"></div>
      <div id="bottom-text" class="meme-text"></div>
    </div>
  </div>
</div>

<script>
// --- 抓取所有需要的 DOM 元素 ---
const imageInput = document.getElementById('image-input');
const memeImage = document.getElementById('meme-image');
const memeCanvas = document.getElementById('meme-canvas');
const placeholder = document.querySelector('.placeholder');

const inputTop = document.getElementById('input-top');
const inputBottom = document.getElementById('input-bottom');
const topText = document.getElementById('top-text');
const bottomText = document.getElementById('bottom-text');

const sizeSlider = document.getElementById('size-slider');
const topPosSlider = document.getElementById('top-pos-slider');
const bottomPosSlider = document.getElementById('bottom-pos-slider');

const sizeValue = document.getElementById('size-value');
const topPosValue = document.getElementById('top-pos-value');
const bottomPosValue = document.getElementById('bottom-pos-value');
const downloadBtn = document.getElementById('download-btn');

// --- 1. 本機圖片上傳功能 (核心避雷) ---
imageInput.addEventListener('change', function(e){
  const file = e.target.files[0];
  if(!file) return;

  // FileReader 會把圖片讀成 base64，就不會有 CORS 問題
  const reader = new FileReader();
  reader.onload = function(event){
    memeImage.src = event.target.result;
    memeImage.style.display = 'block';
    placeholder.style.display = 'none';
    downloadBtn.disabled = false; // 有圖片才能下載
  };
  reader.readAsDataURL(file);
});

// --- 2. 雙層文字即時顯示 ---
function updateTexts(){
  topText.textContent = inputTop.value;
  bottomText.textContent = inputBottom.value;
}
inputTop.addEventListener('input', updateTexts);
inputBottom.addEventListener('input', updateTexts);
updateTexts(); // 初始化

// --- 3. 滑桿控制 ---
sizeSlider.addEventListener('input', function(){
  const size = this.value + 'px';
  topText.style.fontSize = size;
  bottomText.style.fontSize = size;
  sizeValue.textContent = size;
});

topPosSlider.addEventListener('input', function(){
  topText.style.top = this.value + '%';
  topPosValue.textContent = this.value + '%';
});

bottomPosSlider.addEventListener('input', function(){
  // 下方是用 bottom 定位
  bottomText.style.bottom = this.value + '%';
  bottomPosValue.textContent = this.value + '%';
});

// 初始化文字大小
topText.style.fontSize = sizeSlider.value + 'px';
bottomText.style.fontSize = sizeSlider.value + 'px';

// --- 4. 一鍵下載功能 ---
downloadBtn.addEventListener('click', async function(){
  // 提示使用者
  const originalText = downloadBtn.textContent;
  downloadBtn.textContent = '⏳ 產生中...';
  
  try{
    // html2canvas 把整個 #meme-canvas 區塊轉成 canvas
    const canvas = await html2canvas(memeCanvas, {
      useCORS: true,
      scale: 2, // 2倍畫質，比較清晰
      backgroundColor: null
    });

    // 轉成連結並自動下載
    const link = document.createElement('a');
    link.download = 'my-meme.png';
    link.href = canvas.toDataURL('image/png');
    link.click();
  }catch(err){
    alert('下載失敗：' + err.message);
  }
  
  downloadBtn.textContent = originalText;
});
</script>
</body>
</html>
