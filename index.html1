<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>自定義迷因產生器</title>
    <!-- 引入 Google Fonts：Fredoka 與 Noto Sans TC 打造休閒輕鬆感 -->
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;700&family=Noto+Sans+TC:wght@400;700&display=swap" rel="stylesheet">
    <!-- 引入 html2canvas CDN 供截圖下載使用 -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

    <style>
        /* CSS 樣式設定：休閒輕鬆風 */
        :root {
            --bg-color: #f7f9fc;
            --card-bg: #ffffff;
            --primary-color: #ff6b6b;
            --primary-hover: #ff5252;
            --text-color: #2d3436;
            --border-color: #dfe6e9;
            --radius: 16px;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Noto Sans TC', 'Fredoka', sans-serif;
            background-color: var(--bg-color);
            color: var(--text-color);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 20px;
        }

        header {
            margin-bottom: 24px;
            text-align: center;
        }

        header h1 {
            font-family: 'Fredoka', sans-serif;
            color: var(--primary-color);
            font-size: 2.2rem;
            margin-bottom: 6px;
        }

        header p {
            color: #636e72;
            font-size: 0.95rem;
        }

        /* 主容器：採用 Flexbox 進行響應式左右排版 */
        .container {
            display: flex;
            gap: 24px;
            max-width: 1000px;
            width: 100%;
            background: var(--card-bg);
            padding: 24px;
            border-radius: var(--radius);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
        }

        /* 控制面板區 */
        .control-panel {
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .control-group {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .control-group label {
            font-weight: 700;
            font-size: 0.9rem;
            color: #2d3436;
        }

        input[type="text"], input[type="file"] {
            padding: 10px 14px;
            border: 2px solid var(--border-color);
            border-radius: 10px;
            font-size: 0.95rem;
            outline: none;
            transition: border-color 0.2s;
            font-family: inherit;
        }

        input[type="text"]:focus {
            border-color: var(--primary-color);
        }

        /* 滑桿微調區 */
        .range-container {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        input[type="range"] {
            flex: 1;
            accent-color: var(--primary-color);
            cursor: pointer;
        }

        .range-value {
            font-size: 0.85rem;
            color: #636e72;
            min-width: 40px;
            text-align: right;
        }

        /* 下載按鈕設計 */
        .download-btn {
            background-color: var(--primary-color);
            color: white;
            border: none;
            padding: 14px;
            font-size: 1rem;
            font-weight: 700;
            border-radius: 12px;
            cursor: pointer;
            transition: background 0.2s, transform 0.1s;
            margin-top: 10px;
            box-shadow: 0 4px 12px rgba(255, 107, 107, 0.3);
        }

        .download-btn:hover {
            background-color: var(--primary-hover);
        }

        .download-btn:active {
            transform: scale(0.98);
        }

        /* 迷因即時預覽區 */
        .preview-area {
            flex: 1;
            display: flex;
            justify-content: center;
            align-items: center;
            background-color: #f1f2f6;
            border-radius: 12px;
            padding: 16px;
            overflow: hidden;
        }

        /* 迷因卡片容器（html2canvas 截圖的目標） */
        #meme-card {
            position: relative;
            width: 100%;
            max-width: 400px;
            aspect-ratio: 1 / 1; /* 固定為正方形方便排版 */
            background-color: #ddd;
            border-radius: 8px;
            overflow: hidden;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        #meme-card img {
            width: 100%;
            height: 100%;
            object-fit: cover; /* 確保圖片不變形填滿 */
            display: block;
        }

        /* 迷因文字共通樣式：粗體、全大寫感、強烈黑邊框 */
        .meme-text {
            position: absolute;
            width: 90%;
            text-align: center;
            font-family: 'Fredoka', 'Noto Sans TC', sans-serif;
            font-weight: 700;
            color: #ffffff;
            text-transform: uppercase;
            /* 關鍵：利用多重文字陰影做出完美的黑色粗邊框，在任何底圖都清晰可見 */
            text-shadow: 
                -2px -2px 0 #000,  
                 2px -2px 0 #000,
                -2px  2px 0 #000,
                 2px  2px 0 #000,
                 0 2px 4px rgba(0,0,0,0.6);
            word-break: break-word;
            pointer-events: none; /* 讓滑鼠點擊穿透文字，避免干擾 */
            left: 50%;
            transform: translateX(-50%);
        }

        #top-text-display {
            top: 10%; /* 預設初始位置 */
        }

        #bottom-text-display {
            bottom: 10%; /* 預設初始位置 */
        }

        /* RWD 響應式調整：手機版改為上下堆疊 */
        @media (max-width: 768px) {
            .container {
                flex-direction: column;
                padding: 16px;
            }
            header h1 {
                font-size: 1.8rem;
            }
        }
    </style>
</head>
<body>

    <header>
        <h1>✨ 輕鬆迷因產生器 ✨</h1>
        <p>上傳圖片、輸入文字、隨心調整，一鍵下載你的專屬迷因！</p>
    </header>

    <div class="container">
        <!-- 左側：控制面板 -->
        <div class="control-panel">
            <!-- 1. 本機圖片上傳 -->
            <div class="control-group">
                <label for="image-input">選擇底圖 (支援 JPG/PNG)</label>
                <input type="file" id="image-input" accept="image/*">
            </div>

            <!-- 2. 上方文字輸入 -->
            <div class="control-group">
                <label for="top-text-input">上方文字</label>
                <input type="text" id="top-text-input" placeholder="例如：當你寫完程式..." value="當你寫完程式...">
            </div>

            <!-- 3. 下方文字輸入 -->
            <div class="control-group">
                <label for="bottom-text-input">下方文字</label>
                <input type="text" id="bottom-text-input" placeholder="例如：發現竟然一次就過" value="發現竟然一次就過">
            </div>

            <!-- 4. 字體大小滑桿 -->
            <div class="control-group">
                <label>字體大小</label>
                <div class="range-container">
                    <input type="range" id="font-size-range" min="16" max="64" value="32">
                    <span class="range-value" id="font-size-val">32px</span>
                </div>
            </div>

            <!-- 5. 上方文字垂直位置滑桿 -->
            <div class="control-group">
                <label>上方文字垂直位置</label>
                <div class="range-container">
                    <input type="range" id="top-pos-range" min="2" max="80" value="10">
                    <span class="range-value" id="top-pos-val">10%</span>
                </div>
            </div>

            <!-- 6. 下方文字垂直位置滑桿 -->
            <div class="control-group">
                <label>下方文字垂直位置</label>
                <div class="range-container">
                    <input type="range" id="bottom-pos-range" min="2" max="80" value="10">
                    <span class="range-value" id="bottom-pos-val">10%</span>
                </div>
            </div>

            <!-- 7. 一鍵下載按鈕 -->
            <button class="download-btn" id="download-btn">📥 下載迷因圖檔</button>
        </div>

        <!-- 右側：迷因即時預覽區 -->
        <div class="preview-area">
            <!-- 截圖核心區塊 (包含底圖與文字) -->
            <div id="meme-card">
                <!-- 預設一張預留底圖 (使用灰色佔位或範例圖) -->
                <img id="meme-image" src="https://postimg.cc/Mfcj0k02" alt="Meme Background">
                <div id="top-text-display" class="meme-text">耳機裡放著最甜的歌</div>
                <div id="bottom-text-display" class="meme-text">臉上擺著最臭的表情</div>
            </div>
        </div>
    </div>

    <script>
        // 取得 DOM 元素
        const imageInput = document.getElementById('image-input');
        const memeImage = document.getElementById('meme-image');
        
        const topTextInput = document.getElementById('top-text-input');
        const bottomTextInput = document.getElementById('bottom-text-input');
        
        const topTextDisplay = document.getElementById('top-text-display');
        const bottomTextDisplay = document.getElementById('bottom-text-display');
        
        const fontSizeRange = document.getElementById('font-size-range');
        const fontSizeVal = document.getElementById('font-size-val');
        
        const topPosRange = document.getElementById('top-pos-range');
        const topPosVal = document.getElementById('top-pos-val');
        
        const bottomPosRange = document.getElementById('bottom-pos-range');
        const bottomPosVal = document.getElementById('bottom-pos-val');
        
        const downloadBtn = document.getElementById('download-btn');
        const memeCard = document.getElementById('meme-card');

        // 1. 處理本機圖片上傳與 FileReader 預覽 (避開 CORS 錯誤)
        imageInput.addEventListener('change', function(event) {
            const file = event.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    memeImage.src = e.target.result; // 將圖片讀取為 Base64 字串並賦值給 img
                }
                reader.readAsDataURL(file);
            }
        });

        // 2. 即時同步文字內容
        topTextInput.addEventListener('input', function() {
            topTextDisplay.textContent = this.value;
        });

        bottomTextInput.addEventListener('input', function() {
            bottomTextDisplay.textContent = this.value;
        });

        // 3. 調整字體大小
        fontSizeRange.addEventListener('input', function() {
            const size = this.value + 'px';
            topTextDisplay.style.fontSize = size;
            bottomTextDisplay.style.fontSize = size;
            fontSizeVal.textContent = size;
        });

        // 4. 調整上方文字垂直位置
        topPosRange.addEventListener('input', function() {
            const pos = this.value + '%';
            topTextDisplay.style.top = pos;
            topTextDisplay.style.bottom = 'auto'; // 清除衝突
            topPosVal.textContent = pos;
        });

        // 5. 調整下方文字垂直位置
        bottomPosRange.addEventListener('input', function() {
            const pos = this.value + '%';
            bottomTextDisplay.style.bottom = pos;
            bottomTextDisplay.style.top = 'auto'; // 清除衝突
            bottomPosVal.textContent = pos;
        });

        // 6. 使用 html2canvas 實作一鍵下載圖檔功能
        downloadBtn.addEventListener('click', function() {
            // 呼叫 html2canvas 套件截取指定的 #meme-card 元素
            html2canvas(memeCard, {
                useCORS: true, // 啟用跨域支援
                scale: 2       // 提高輸出圖片的清晰度 (2倍解析度)
            }).then(canvas => {
                // 將 canvas 轉為圖片下載連結
                const link = document.createElement('a');
                link.download = 'my-meme.png'; // 指定下載檔名
                link.href = canvas.toDataURL('image/png');
                link.click(); // 自動觸發下載
            }).catch(err => {
                console.error("截圖失敗：", err);
                alert("圖片下載失敗，請稍後再試！");
            });
        });
    </script>
</body>
</html>
